# The browser uses same-origin /api routes; no public API URL is needed.
# Future server secrets belong only here, without NEXT_PUBLIC_ prefix.

# Photo calorie estimation. Without a key the API returns labelled sample
# estimates instead of analysing the photo.
# ANTHROPIC_API_KEY=
# CALORIE_ESTIMATOR_MODEL=claude-opus-5-5
# CALORIE_ESTIMATOR=mock

# Database. Unset = in-process PGlite in .data/pglite (no server needed).
# Local Docker (`pnpm db:up`):
# DATABASE_URL=postgres://calorie:calorie@localhost:5432/calorie_donate
# Production (Neon): the pooled connection string with ?sslmode=require
# PGLITE_DATA_DIR=memory://
# DATABASE_AUTO_MIGRATE=false
